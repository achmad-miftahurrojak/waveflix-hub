{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "waveflix-app/frontend",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" },
        { "type": "service", "service": "backend", "format": "url", "env": "NEXT_PUBLIC_BACKEND_URL" }
      ]
    },
    "backend": {
      "root": "waveflix-app/backend",
      "runtime": "go",
      "entrypoint": "main.go",
      "bindings": [
        { "type": "service", "service": "waveflix-extractor", "format": "url", "env": "EXTRACTOR_URL" }
      ]
    },
    "waveflix-extractor": {
      "root": "waveflix-extractor",
      "framework": "express"
    },
    "waveflix-web": {
      "root": "waveflix-web", 
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "frontend", "format": "url", "env": "NEXT_PUBLIC_FRONTEND_URL" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/landing/(.*)",
      "destination": {
        "service": "waveflix-web"
      }
    },
    {
      "source": "/landing",
      "destination": {
        "service": "waveflix-web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}