{
  "name": "WaveFlix Hub",
  "short_name": "WaveFlix",
  "description": "Platform streaming katalog film & serial berbasis web",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#6366f1",
  "orientation": "portrait-primary",
  "categories": ["entertainment", "movies", "tv"],
  "lang": "id-ID",
  
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-96x96.png", 
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128", 
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png", 
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  
  "screenshots": [
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "platform": "wide"
    },
    {
      "src": "/screenshots/mobile-1.png", 
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow"
    }
  ],
  
  "shortcuts": [
    {
      "name": "Trending",
      "short_name": "Trending",
      "url": "/trending",
      "icons": [
        {
          "src": "/icons/shortcut-trending.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Browse Movies",
      "short_name": "Movies", 
      "url": "/browse?media=movie",
      "icons": [
        {
          "src": "/icons/shortcut-movies.png",
          "sizes": "192x192", 
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Browse TV Shows",
      "short_name": "TV Shows",
      "url": "/browse?media=tv",
      "icons": [
        {
          "src": "/icons/shortcut-tv.png",
          "sizes": "192x192",
          "type": "image/png" 
        }
      ]
    },
    {
      "name": "My Watchlist",
      "short_name": "Watchlist",
      "url": "/daftar-saya",
      "icons": [
        {
          "src": "/icons/shortcut-watchlist.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://waveflix-hub.vercel.app/manifest.json"
    }
  ],
  
  "prefer_related_applications": false,
  
  "scope": "/",
  "id": "waveflix-hub",
  
  "protocol_handlers": [
    {
      "protocol": "web+waveflix",
      "url": "/share?url=%s"
    }
  ],
  
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text", 
      "url": "url"
    }
  },
  
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ]
}