# Template konfigurasi backend. Salin ke `.env` lalu isi nilainya.
#   cp .env.example .env

# ======================================
# DATABASE CONFIGURATION
# ======================================

# Database type: "sqlite" (default) or "postgres"
# DATABASE_TYPE determines which database backend to use
# - sqlite: Local file-based database (default, backward compatible)
# - postgres: PostgreSQL server (recommended for production)
DATABASE_TYPE=sqlite

# PostgreSQL Connection (when DATABASE_TYPE=postgres)
# Option 1: Connection URL (recommended)
# DATABASE_URL=postgresql://username:password@hostname:port/database?sslmode=require

# Option 2: Individual parameters (alternative to DATABASE_URL)
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=waveflix
# PG_PASSWORD=your-secure-password
# PG_DATABASE=waveflix_hub
# PG_SSLMODE=require

# PostgreSQL Connection Pool Settings
# PG_MAX_CONNS: Maximum open connections (default: 25)
# Formula: CPU cores * 2 + disk spindles. For cloud DBs, start with 25.
PG_MAX_CONNS=25

# PG_MAX_IDLE_CONNS: Maximum idle connections (default: 25)
# Should typically match PG_MAX_CONNS for consistent performance
PG_MAX_IDLE_CONNS=25

# Advanced PostgreSQL Settings (optional)
# PG_CONN_MAX_LIFETIME: Connection lifetime in minutes (default: 30)
# PG_CONN_MAX_IDLE_TIME: Max idle time in minutes (default: 10)  
# PG_HEALTH_CHECK_INTERVAL: Health check frequency in seconds (default: 60)

# SQLite Configuration (when DATABASE_TYPE=sqlite)
# SQLITE_FILE: Database file path (default: waveflix.db)
# SQLITE_FILE=waveflix.db

# ======================================
# EXTERNAL APIS
# ======================================

# TMDB API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Trakt.tv (https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=http://localhost:3000/trakt/callback

# ======================================
# SECURITY & DEPLOYMENT
# ======================================

# Production security
ALLOWED_ORIGIN=http://localhost:3000
TRUSTED_PROXY_IPS=
AUTH_COOKIE_SECURE=0

# ======================================
# EMAIL CONFIGURATION
# ======================================

# Email verification (required outside E2E_TEST_MODE)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-email@gmail.com

# ======================================
# DATABASE MIGRATION EXAMPLES
# ======================================

# Example configurations for different deployment scenarios:

# Development (SQLite - default):
# DATABASE_TYPE=sqlite
# SQLITE_FILE=waveflix.db

# Local PostgreSQL development:
# DATABASE_TYPE=postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=waveflix_dev
# PG_PASSWORD=dev_password
# PG_DATABASE=waveflix_dev
# PG_SSLMODE=disable

# Production PostgreSQL (Heroku, Railway, etc):
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://user:pass@host:port/db?sslmode=require

# Production PostgreSQL (manual config):
# DATABASE_TYPE=postgres
# PG_HOST=your-postgres-server.com
# PG_PORT=5432
# PG_USER=waveflix_prod
# PG_PASSWORD=your-secure-production-password
# PG_DATABASE=waveflix_production
# PG_SSLMODE=require
# PG_MAX_CONNS=50
# PG_MAX_IDLE_CONNS=50

