package main

import (
	"context"
	"fmt"
	"log"

	"github.com/jackc/pgx/v5"
)

func main() {
	conn, err := pgx.Connect(context.Background(), "postgres://waveflix@localhost:5432/waveflix?sslmode=disable")
	if err != nil {
		log.Fatal(err)
	}
	defer conn.Close(context.Background())

	tag, err := conn.Exec(context.Background(), "DELETE FROM users WHERE email = $1", "rozakahmad0769@gmail.com")
	if err != nil {
		log.Fatal(err)
	}
	fmt.Printf("Deleted %d rows\n", tag.RowsAffected())
    
    rows, err := conn.Query(context.Background(), "SELECT column_name FROM information_schema.columns WHERE table_name = 'profiles'")
    if err != nil {
        log.Fatal(err)
    }
    defer rows.Close()
    fmt.Print("Profile columns: ")
    for rows.Next() {
        var col string
        rows.Scan(&col)
        fmt.Print(col, ", ")
    }
    fmt.Println()
}
