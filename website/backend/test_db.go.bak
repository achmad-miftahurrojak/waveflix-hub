package main

import (
    "database/sql"
    "fmt"
    _ "github.com/lib/pq"
    "log"
)

func main() {
    db, err := sql.Open("postgres", "host=localhost port=5432 user=waveflix dbname=waveflix sslmode=disable")
    if err != nil {
        log.Fatal(err)
    }
    defer db.Close()
    
    // Delete the user
    res, err := db.Exec("DELETE FROM users WHERE email = $1", "rozakahmad0769@gmail.com")
    if err != nil {
        fmt.Println("Error deleting user:", err)
    } else {
        rows, _ := res.RowsAffected()
        fmt.Println("Deleted users:", rows)
    }
    
    // Check profiles schema
    rows, err := db.Query("SELECT column_name FROM information_schema.columns WHERE table_name = 'profiles'")
    if err != nil {
        fmt.Println("Error getting columns:", err)
    } else {
        fmt.Print("Profile columns: ")
        for rows.Next() {
            var col string
            rows.Scan(&col)
            fmt.Print(col, ", ")
        }
        fmt.Println()
    }
}
