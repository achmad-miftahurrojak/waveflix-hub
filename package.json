{
  "name": "waveflix-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta,green,blue\" -n \"PYTHON,GO,APP,WEB\" \"npm run dev:python\" \"npm run dev:backend\" \"npm run dev:app\" \"npm run dev:web\"",
    "dev:python": "cd Vidlink.pro-Decryptor && python main.py",
    "dev:backend": "cd waveflix-app/backend && go run .",
    "dev:app": "cd waveflix-app/frontend && npm run dev -- -p 3000",
    "dev:web": "cd waveflix-web && npm run dev -- -p 3001"
  },
  "dependencies": {
    "framer-motion": "^13.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
