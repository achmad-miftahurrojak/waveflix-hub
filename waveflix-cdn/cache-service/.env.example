# Cache Service Configuration

# Service Configuration
NODE_ENV=development
PORT=3003
NODE_ID=cache-node-1
REGION=us-east-1

# Cache Tier Configuration
CACHE_TIER=L1
ENABLE_TRANSCODING=false
ENABLE_PROCESSING=false
ENABLE_ANALYTICS=true

# Redis Configuration - L2 Regional Cache
REDIS_L2_HOST=localhost
REDIS_L2_PORT=6379
REDIS_PASSWORD=waveflix-redis-pass

# Redis Configuration - L3 Origin Cache  
REDIS_L3_HOST=localhost
REDIS_L3_PORT=6380

# Coordination Redis
COORDINATION_REDIS_HOST=localhost
COORDINATION_REDIS_PORT=6379

# Analytics Redis
ANALYTICS_REDIS_HOST=localhost
ANALYTICS_REDIS_PORT=6381

# Memory Limits
NODE_MEMORY_LIMIT=4294967296

# Monitoring Configuration
ENABLE_METRICS=true
ENABLE_ALERTS=true
METRICS_RETENTION=604800

# Performance Tuning
CACHE_OPTIMIZATION_THRESHOLD=0.85
POPULAR_CONTENT_THRESHOLD=100
HEARTBEAT_INTERVAL=10
HEALTH_CHECK_INTERVAL=15

# Security
REDIS_TLS_ENABLED=false
ENABLE_AUTH=true
API_KEY_REQUIRED=false

# Logging
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/cache-service.log