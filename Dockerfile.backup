# Dockerfile for PostgreSQL Backup Service
FROM postgres:15-alpine

# Install additional tools for backup operations
RUN apk add --no-cache \
    bash \
    curl \
    gzip \
    aws-cli \
    postgresql-client \
    jq \
    coreutils \
    findutils \
    tzdata

# Create backup directory
RUN mkdir -p /backups /scripts

# Set timezone
ENV TZ=UTC

# Copy backup scripts
COPY scripts/backup_postgres.sh /scripts/
COPY scripts/backup_health_check.sh /scripts/
COPY scripts/generate_recovery_report.sh /scripts/

# Make scripts executable
RUN chmod +x /scripts/*.sh

# Create backup user
RUN addgroup -g 1001 backup && \
    adduser -D -u 1001 -G backup backup

# Set proper permissions
RUN chown -R backup:backup /backups /scripts

# Switch to backup user
USER backup

# Set working directory
WORKDIR /backups

# Default command
CMD ["tail", "-f", "/dev/null"]